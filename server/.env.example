# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:your_password@127.0.0.1:5432/quzi

# Cloudflare Tunnel / Public HTTPS URL for mobile phones to connect from anywhere
# Example: https://my-quiz-arena.trycloudflare.com
PUBLIC_URL=https://your-tunnel.trycloudflare.com

# Backend Server Port
PORT=3001

# Google Gemini API Key for AI-powered PDF Multiple Choice Question extraction (optional)
GEMINI_API_KEY=your_gemini_api_key_here
